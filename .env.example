# Ключи YandexGPT по порядку; пустые ключи пропускаются
# При обычном Docker-запуске создаются admin/admin и сохранённый пример на 1000 строк.
# Для размещения без стартовой учётной записи и примера: JURY_DATA=0.
JURY_DATA=1
LLM_PROVIDERS=yandex,yandex2,yandex3,yandex4,yandex5
# Секунд на все запросы к нейросети в одном задании
LLM_BUDGET=240
# Строк в одном запросе к нейросети
LLM_BATCH=10
# Второе мнение нейросети по спорным строкам: 1 — включено, 0 — выключено
LLM_CHOOSE=1
# Секунд на второе мнение
LLM_CHOOSE_BUDGET=90

# Адрес API Yandex AI Studio
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Основной API-ключ Yandex AI Studio (нужен обязательно)
YANDEX_API_KEY=
# ID каталога в Yandex Cloud, начинается с b1g (нужен обязательно)
YANDEX_FOLDER_ID=
# Модель YandexGPT
YANDEX_MODEL=yandexgpt-5.1
# Запросов одновременно на ключ; auto делит 5 генераций облака между его ключами
YANDEX_PARALLEL=auto
# Предел длины ответа нейросети в токенах
YANDEX_MAX_TOKENS=8000

# Дополнительные ключи ускоряют обработку (необязательно)
YANDEX2_API_KEY=
YANDEX3_API_KEY=
YANDEX4_API_KEY=
YANDEX5_API_KEY=
# Каталог ключа из другого облака; пустой — берётся YANDEX_FOLDER_ID
YANDEX2_FOLDER_ID=
YANDEX3_FOLDER_ID=
YANDEX4_FOLDER_ID=
YANDEX5_FOLDER_ID=

# Общедоступный адрес каталога; пустой — релиз GitHub (нужен доступ к репозиторию)
CATALOG_RELEASE_URL=

# Ключ и каталог для векторного поиска; пустые — берутся YANDEX_API_KEY и YANDEX_FOLDER_ID
YANDEX_EMBED_API_KEY=
YANDEX_EMBED_FOLDER_ID=

# База PostgreSQL внутри docker compose
POSTGRES_USER=ktru
POSTGRES_PASSWORD=ktru
POSTGRES_DB=ktru
