# NVIDIA GPU for the embeddings with the same "docker compose up -d --build": uncomment both lines
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml

# Recommended: DeepSeek through one Yandex key (payment in Yandex Cloud).
# PARALLEL means concurrent requests using the SAME key, not additional accounts.
# Check the key after rebuilding the backend:
# docker compose exec backend python check_llm.py
LLM_PROVIDERS=yandex2
# Alternative direct DeepSeek API: set LLM_PROVIDERS=deepseek and fill this key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PARALLEL=4
DEEPSEEK_RPM=0
# Thinking is disabled in providers.py; no separate training or model hosting is needed.

# Alternative: LLM_PROVIDERS=yandex,yandex2,yandex3,yandex4,yandex5,gigachat
# Yandex AI Studio: five independent API keys; the folder ID is also required.
# Shared settings below apply to yandex2..yandex5. Override e.g. YANDEX2_FOLDER_ID when needed.
# The OpenAI-compatible API accepts Bearer API keys and the x-project folder header.
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm-flash
YANDEX_API_KEY=
YANDEX2_API_KEY=
YANDEX2_FOLDER_ID=
YANDEX2_MODEL=deepseek-v4.1-flash/latest
YANDEX2_REASONING_EFFORT=none
YANDEX2_PARALLEL=4
YANDEX3_API_KEY=
YANDEX3_FOLDER_ID=
YANDEX4_API_KEY=
YANDEX4_FOLDER_ID=
YANDEX5_API_KEY=
YANDEX5_FOLDER_ID=
# All Yandex providers share this additional cap; keys of one cloud do not multiply its quota.
# Four requests were tested on our account. Reduce both caps to 2 if your quota requires it.
YANDEX_PARALLEL=1
YANDEX_TOTAL_PARALLEL=4
# Five independent clouds, one request each: set YANDEX_TOTAL_PARALLEL=5.
YANDEX_RPM=0

# Seconds for all neural network requests of one job (rows left after it get the rules).
# Search and embeddings take additional time; measure the full job on your hardware.
LLM_BUDGET=240
# Small batches keep output latency below the request timeout.
LLM_BATCH=5
# Compact wire fields; the backend restores the unchanged public attribute schema.
LLM_COMPACT=1
# Known catalog names with explicit characteristic fields are parsed locally; others use LLM.
LLM_LOCAL_STRUCTURED=1
# Timeout per HTTP attempt; avoid paying for multiple long retries during an outage.
LLM_REQUEST_TIMEOUT=60
LLM_RETRIES=1
# Second opinion: a neural network picks the code from the top-5 for the doubtful rows (0 = off)
LLM_CHOOSE=1
LLM_CHOOSE_BUDGET=90

# Gemini through its OpenAI-compatible API, one provider per Google account.
# Free Gemini 3.5 Flash Lite (22.10.2026): 15 requests a minute, 500 a day, 250K tokens a minute
# for each key's Google Cloud project, so three keys of three projects give three times that.
# X_PARALLEL - requests at the same moment; X_RPM - requests per minute: they are spaced by
# 60 / X_RPM seconds instead of running into 429 (set it a little below the plan's limit).
# Gemini 3.1 Flash Lite has the same 15 and 500; a day of testing uses them up (then 429).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PARALLEL=4
GEMINI_RPM=14

GEMINI2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI2_API_KEY=
GEMINI2_MODEL=gemini-3.5-flash-lite
GEMINI2_PARALLEL=4
GEMINI2_RPM=14

GEMINI3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI3_API_KEY=
GEMINI3_MODEL=gemini-3.5-flash-lite
GEMINI3_PARALLEL=4
GEMINI3_RPM=14

# Keys 4 and 5 need only their own line: address, model and limits are taken from GEMINI_*
GEMINI4_API_KEY=
GEMINI5_API_KEY=

# GigaChat (Sber). Empty credentials: attributes are extracted by simple rules, everything else works.
# Base address of the API, with /v1
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Authorization key from the GigaChat API cabinet (Base64 of Client ID:Client Secret)
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS - individuals, GIGACHAT_API_B2B - paid packages, GIGACHAT_API_CORP - pay-as-you-go
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Where the access token is taken (valid for 30 minutes)
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GigaChat certificates are signed by the Russian root CA (Минцифры).
# false - no certificate check (as in the Sber example; insecure: the key can be intercepted),
# path to a .pem/.crt with that CA inside the backend container - the check stays on.
GIGACHAT_VERIFY_SSL=false
# Requests to GigaChat at the same moment: Freemium allows 1 (a second one gets 429)
GIGACHAT_PARALLEL=1

# Hybrid search: codes found by BM25 over code names added to the vector top-50 (0 = off)
# LEX_LIMIT=20

# PostgreSQL inside docker compose
POSTGRES_USER=ktru
POSTGRES_PASSWORD=ktru
POSTGRES_DB=ktru

# Embeddings: the ollama container by default; with an NVIDIA GPU start with
# docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# OLLAMA_URL=http://ollama:11434
# The model must be the one the catalog dump was embedded with
# EMBED_MODEL=bge-m3

# Jobs processed at the same moment (threads of the backend)
# WORKERS=2
