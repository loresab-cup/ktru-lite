# YandexGPT (Yandex AI Studio): API key and folder ID (b1g...) of the cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
# Requests at the same moment per key; auto shares the 5 generations of a cloud between its keys
YANDEX_PARALLEL=auto

# Optional extra keys for speed; a key from another cloud also needs YANDEXn_FOLDER_ID
YANDEX2_API_KEY=
YANDEX3_API_KEY=
YANDEX4_API_KEY=
YANDEX5_API_KEY=
LLM_PROVIDERS=yandex,yandex2,yandex3,yandex4,yandex5

# Embeddings for the search; empty: the YandexGPT key and folder above are used
YANDEX_EMBED_API_KEY=
YANDEX_EMBED_FOLDER_ID=

# Rows per LLM request and seconds for all LLM requests of one job
LLM_BATCH=10
LLM_BUDGET=240

# PostgreSQL inside docker compose
POSTGRES_USER=ktru
POSTGRES_PASSWORD=ktru
POSTGRES_DB=ktru

# Contact shown on the privacy policy page
PRIVACY_OPERATOR_NAME=Маслов К. Р.
PRIVACY_CONTACT_EMAIL=krm5@tpu.ru

# 1 when the site is served over HTTPS
COOKIE_SECURE=0
