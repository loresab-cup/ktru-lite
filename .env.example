# Neural network by the Anthropic Messages protocol. URL without /v1.
# Empty key: attributes are extracted by simple rules, everything else works.
LLM_API_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_API_MODEL=claude-sonnet-5

# PostgreSQL inside docker compose
POSTGRES_USER=ktru
POSTGRES_PASSWORD=ktru
POSTGRES_DB=ktru
