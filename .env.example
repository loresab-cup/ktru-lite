# NVIDIA GPU for the embeddings with the same "docker compose up -d --build": uncomment both lines
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml

# Neural networks for the attributes, comma-separated; the order is the priority.
# Each one has its own limit of requests at the same moment (*_PARALLEL).
# Check the keys: docker compose exec backend python check_llm.py
LLM_PROVIDERS=gigachat
# Fastest first: the first batches of a job go to the first free provider in this list

# Seconds for all neural network requests of one job (rows left after it get the rules).
# 240 s + the search stays within 5 minutes for 1000 rows; add *_PARALLEL rather than budget.
LLM_BUDGET=240
# Second opinion: a neural network picks the code from the top-5 for the doubtful rows (0 = off)
LLM_CHOOSE=1
LLM_CHOOSE_BUDGET=90

# Yandex AI Studio (docs/YANDEX_SETUP.md). Add "yandex" to LLM_PROVIDERS to use it.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=qwen3.6-35b-a3b
# The folder quota is 2 synchronous requests at the same moment unless it was raised
YANDEX_PARALLEL=2

# OpenAI-compatible gateways (POST {BASE_URL}/chat/completions, "Authorization: Bearer <key>").
# Add the name to LLM_PROVIDERS, e.g. LLM_PROVIDERS=gigachat,routerai,polza,tokify,claudecodex
# X_PARALLEL - requests at the same moment the gateway allows (raise it if there is no 429);
# X_REASONING_EFFORT=none speeds up models that think before answering (if the model supports it).
CLAUDECODEX_BASE_URL=https://claude-n-codex.com:8443/v1
CLAUDECODEX_API_KEY=
CLAUDECODEX_MODEL=claude-sonnet-5
CLAUDECODEX_PARALLEL=6

TOKIFY_BASE_URL=https://tokify.sale/v1
TOKIFY_API_KEY=
TOKIFY_MODEL=gpt-5.6-luna
TOKIFY_REASONING_EFFORT=none
TOKIFY_PARALLEL=6

ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_API_KEY=
ROUTERAI_MODEL=google/gemini-2.5-flash-lite
ROUTERAI_PARALLEL=3

POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_API_KEY=
POLZA_MODEL=google/gemini-3.1-flash-lite
POLZA_PARALLEL=3

# GigaChat (Sber). Empty credentials: attributes are extracted by simple rules, everything else works.
# Base address of the API, with /v1
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Authorization key from the GigaChat API cabinet (Base64 of Client ID:Client Secret)
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS - individuals, GIGACHAT_API_B2B - paid packages, GIGACHAT_API_CORP - pay-as-you-go
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Where the access token is taken (valid for 30 minutes)
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GigaChat certificates are signed by the Russian root CA (Минцифры).
# false - no certificate check (as in the Sber example; insecure: the key can be intercepted),
# path to a .pem/.crt with that CA inside the backend container - the check stays on.
GIGACHAT_VERIFY_SSL=false
# Requests to GigaChat at the same moment: Freemium allows 1 (a second one gets 429)
GIGACHAT_PARALLEL=1

# Hybrid search: codes found by BM25 over code names added to the vector top-50 (0 = off)
# LEX_LIMIT=20

# PostgreSQL inside docker compose
POSTGRES_USER=ktru
POSTGRES_PASSWORD=ktru
POSTGRES_DB=ktru

# Embeddings: the ollama container by default; with an NVIDIA GPU start with
# docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# OLLAMA_URL=http://ollama:11434
