# Neural networks for the attributes, comma-separated; the order is the priority: the first
# batches of a job go to the first free provider. Five YandexGPT keys (Yandex AI Studio);
# Check the Yandex keys:
# docker compose exec backend python check_llm.py
LLM_PROVIDERS=yandex,yandex2,yandex3,yandex4,yandex5

# Seconds for all neural network requests of one job (rows left after it get the rules).
# 240 s + the search stays within 5 minutes for 1000 rows. Measured 28.10.2026 with five
# yandexgpt-5.1 keys and Yandex embeddings: 1000 rows in 211-227 s, the second opinion included.
LLM_BUDGET=240
# Rows in one request: 10 was fastest in the 5/10/15/20 comparison on 28.10.2026.
# The measured gain was small (203 vs 208 seconds), not a guaranteed speedup. A longer
# answer is cut by max_tokens and the batch is then split in halves.
LLM_BATCH=10
# Second opinion: a neural network picks the code from the top-5 for the doubtful rows (0 = off)
LLM_CHOOSE=1
LLM_CHOOSE_BUDGET=90

# YandexGPT through the OpenAI-compatible API of Yandex AI Studio, one provider per API key.
# A key: AI Studio -> "Создать API-ключ" (top right) makes a service account with the roles it
# needs and a key for all AI Studio services; put its secret here, not its ID. By hand: a service
# account with ai.languageModels.user (or ai.editor) in the folder, a key with the scope
# yc.ai.languageModels.execute. FOLDER_ID is the ID of that folder (b1g...).
# The model is gpt://<FOLDER_ID>/<X_MODEL>; X_MODEL may also be a full gpt://... URI.
# yandexgpt-5.1 is YandexGPT Pro 5.1; aliceai-llm-flash is faster and cheaper. YandexGPT Lite 5
# (yandexgpt-5-lite) is withdrawn on 15.11.2026.
# A cloud runs 5 generations at the same moment for all its keys together (the 6th gets 429):
# five keys of one cloud take X_PARALLEL=1 each; a single key may take 5. Keys of other clouds
# (other accounts) add 5 each: give such a key its own X_FOLDER_ID and X_PARALLEL.
# X_PARALLEL - requests at the same moment; X_RPM - requests per minute (0 - no spacing);
# X_MAX_TOKENS - the answer limit (the model has 32K for the question and the answer).
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
YANDEX_PARALLEL=1
YANDEX_MAX_TOKENS=8000

# Keys 2-5 need only their own API key line; the rest is taken from YANDEX_*.
# A key from another cloud also needs its own folder: YANDEX2_FOLDER_ID=...
YANDEX2_API_KEY=
YANDEX3_API_KEY=
YANDEX4_API_KEY=
YANDEX5_API_KEY=

# Hybrid search: codes found by BM25 over code names added to the vector top-50 (0 = off)
# LEX_LIMIT=20

# Accounts of the site: anyone registers on the login page by login and password. Optional: the
# first admin created at start when there are no users yet. Accounts from the command line:
# docker compose exec backend python users.py list|add|passwd|remove <login>.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Hours a login lasts
# SESSION_HOURS=12
# 1 when the site is served over HTTPS: the session cookie is then sent only over HTTPS
# COOKIE_SECURE=0
# 0 opens the API without a login: only for development
# AUTH_REQUIRED=1

# PostgreSQL inside docker compose
POSTGRES_USER=ktru
POSTGRES_PASSWORD=ktru
POSTGRES_DB=ktru

# Public policy contact. Set full operator details before public deployment.
PRIVACY_OPERATOR_NAME=Маслов К. Р.
PRIVACY_CONTACT_EMAIL=krm5@tpu.ru
PRIVACY_OPERATOR_ADDRESS=

# Embeddings (search by meaning): Yandex AI Studio, rows by text-search-query. The catalog
# vectors of text-search-doc are in db/ktru_vectors_yandex.npz (scripts/embed_catalog.py builds
# them once). The service account needs a Yandex AI Studio role (e.g. ai.languageModels.user) in
# this folder, otherwise 403 PermissionDenied. Without a key the search goes by words only.
YANDEX_EMBED_API_KEY=
YANDEX_EMBED_FOLDER_ID=
# Embedding requests a second for the whole cloud (documented quota 10, 20 passed without 429)
# YANDEX_EMBED_RPS=20

# A code a person accepted or chose for a row goes to the same row of later files (0 = off).
# Turn it off for accuracy measurements on files someone has already corrected.
# REMEMBER_DECISIONS=1

# Finished specifications older than this many days are deleted once an hour, with their rows
# and files; the remembered decisions of people stay. 0 keeps everything.
# JOBS_KEEP_DAYS=0

# Concurrent jobs: Celery threads pool, --concurrency=2 in docker-compose.yml.
# Keep a single worker instance to share the configured LLM provider limits.
