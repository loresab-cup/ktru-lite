.env
.env.*
!.env.example
*.env
*.local

# Dependencies, build output and runtime data.
.venv/
venv/
node_modules/
dist/
__pycache__/
*.pyc
*.tsbuildinfo
.pytest_cache/
.ruff_cache/
.cache/
.uploads/
*.db
*.db-*
*.sqlite
*.sqlite3
*.log

# Development checks stay in the local working copy.
/backend/tests/
/backend/requirements-dev.txt
/frontend/tests/

# Large catalog files are distributed through the catalog_yandex release.
/db/*
!/db/README.md

# Duplicate inputs and dataset audit output.
/dataset/files/
/dataset/results/
